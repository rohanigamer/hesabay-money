rules_version = '2';
// Hesabay Money - Firestore security rules
// Deploy: firebase deploy --only firestore (requires Firebase CLI and project linked)

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read and write their own user document (auth + sync data).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Block all other access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
